	"scripts": {
		"test": "vitest",
		"build": "rollup -c",
		"commit": "git-cz",
		"lint": "prettier --write \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\" && eslint && cspell lint \"**/*.{js,ts,mjs,cjs,json,css,less,scss,vue,html.md}\"",
